#!/usr/bin/env python3
"""fleet-status — read-only manager dashboard for the agent network.

Prints the roster: each agent's online/offline state, last-seen age, and the most
recent line it put on the bus (from log.jsonl) as a proxy for "what it's doing".
Sends NOTHING and consumes NOTHING — safe to run any time.

For an ACTIVE poll (make agents report fresh status), broadcast instead:
    agentnet send all "[status sweep] one line: STATUS: IN-FLIGHT <x> | BLOCKED <y> | IDLE" --kind ask
and read the replies as they stream into your `agentnet watch`. Online agents answer;
offline ones stay quiet (broadcast never wakes — cheap). Agents reply with
    agentnet reply <sweep-id> "STATUS: ..."
so the answer routes back to you with the thread paired in the log.

Usage:  fleet-status [--all]      (--all also lists agents idle >7d)
"""
import json, os, sys
from datetime import datetime, timezone

ROOT = os.path.expanduser("~/.claude/agent-network")
show_all = "--all" in sys.argv

def load(p, d):
    try:
        with open(p) as f: return json.load(f)
    except Exception: return d

agents = load(os.path.join(ROOT, "agents.json"), {})
last = {}
try:
    with open(os.path.join(ROOT, "log.jsonl")) as f:
        for line in f:
            try: m = json.loads(line)
            except Exception: continue
            frm = m.get("from")
            if frm: last[frm] = m   # keep the newest (file is append-order)
except FileNotFoundError:
    pass

now = datetime.now(timezone.utc)
def age_s(iso):
    try: return (now - datetime.fromisoformat(iso)).total_seconds()
    except Exception: return 9e9
def human(s):
    if s < 90:     return f"{int(s)}s"
    if s < 3600:   return f"{int(s/60)}m"
    if s < 86400:  return f"{int(s/3600)}h"
    return f"{int(s/86400)}d"

rows = sorted(agents.items(), key=lambda kv: age_s(kv[1].get("last_seen", "")))
online = sum(1 for _, e in rows if age_s(e.get("last_seen", "")) < 90)
print(f"  agent network — {len(rows)} agents, {online} online   ({now:%Y-%m-%d %H:%M} UTC)")
print(f"  {'AGENT':22} {'STATE':7} {'SEEN':>5}  LAST ON THE BUS")
print("  " + "-" * 96)
for name, e in rows:
    a = age_s(e.get("last_seen", ""))
    if not show_all and a > 7 * 86400:
        continue
    state = "online" if a < 90 else "idle" if a < 3600 else "off"
    body = " ".join((last.get(name, {}).get("body", "") or "").split())[:62]
    print(f"  {name:22} {state:7} {human(a):>5}  {body}")
