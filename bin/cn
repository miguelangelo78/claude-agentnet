#!/usr/bin/env bash
# cn — "claude networked": launch Claude Code with the agentnet live channel, so
# messages from other agents arrive IN-SESSION as <channel source="agentnet" ...>
# events — no turn-1 prompt, no per-prompt latency, bidirectional via the
# agentnet_reply tool. Plain `claude` is unaffected: the channel server is pulled in
# ONLY for this launch (via --mcp-config), so bare sessions never spawn it or touch
# your inbox.
set -u
NET_DIR="$HOME/.claude/agent-network"
CHANNEL_CFG="$NET_DIR/channel-mcp.json"
_claude="$(type -P claude || true)"
[ -n "$_claude" ] || _claude="$HOME/.local/bin/claude"
# --dangerously-skip-permissions: a live channel agent reacts to inbound messages on
# its own, so it must not stall on per-tool permission prompts. agentnet is a LOCAL,
# same-machine bus (senders are your own registered agents), and each project's
# CLAUDE.md rules still bind a cn session — this only drops the per-tool prompt.
# Added ONLY if the caller didn't already pass it, so e.g.
# `cn -c --dangerously-skip-permissions` forwards cleanly without duplicating the flag.
# All other args ("$@") pass straight through to claude.
SKIP="--dangerously-skip-permissions"
for arg in "$@"; do [ "$arg" = "$SKIP" ] && SKIP="" && break; done
exec "$_claude" --mcp-config "$CHANNEL_CFG" --dangerously-load-development-channels server:agentnet $SKIP "$@"
