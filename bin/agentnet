#!/usr/bin/env python3
"""
agentnet — a tiny live message bus for Claude Code agents.

Lets one Claude agent talk DIRECTLY to other Claude agents (1:1 or broadcast),
with no human relaying files. Transport is a shared directory under
~/.claude/agent-network/; the agent-facing verbs are send / recv / watch / ask /
wake. See README.md in that dir.

Identity: an agent's NAME defaults to a slug of its working directory's
basename (so ~/dev/api-server => "api-server"). Override per-dir with
`agentnet register <name>`, or per-process with $AGENTNET_NAME.

Live receive: run `agentnet watch` under the Monitor tool — each inbound message
becomes a live notification while you keep working. Dormant agents: `agentnet
wake <name|--dir DIR>` spawns a headless claude in that dir to join + reply.

Pure stdlib; no deps.
"""
import argparse, json, os, re, sys, time, uuid, subprocess, fcntl
from datetime import datetime, timezone

ROOT = os.path.join(os.path.expanduser("~"), ".claude", "agent-network")
INBOX = os.path.join(ROOT, "inbox")
LOCKS = os.path.join(ROOT, "locks")           # per-agent wake locks (single-worker guard)
AGENTS = os.path.join(ROOT, "agents.json")
DIRNAMES = os.path.join(ROOT, "dir_names.json")
LOG = os.path.join(ROOT, "log.jsonl")
ONLINE_WINDOW_S = 90          # "online" = actively watching within this window
WATCH_HEARTBEAT_EVERY_S = 5   # watch refreshes presence this often
ACTIVELY_WATCHING_S = WATCH_HEARTBEAT_EVERY_S * 3  # ~15s. A live `watch` refreshes every 5s, so a heartbeat older than this means NOT actually watching (e.g. a headless agent that finished + exited leaves a stale-but-recent heartbeat). A send must then RE-WAKE rather than assume the msg is seen.
MAX_DRAIN_ITERS = 25          # wake-worker shepherd: max claude runs in one drain-loop (safety cap against a worker that never empties its inbox)

def now_iso(): return datetime.now(timezone.utc).isoformat()
def now_ms(): return int(time.time() * 1000)
def ensure_dirs():
    os.makedirs(INBOX, exist_ok=True)
    os.makedirs(LOCKS, exist_ok=True)

def _load(path, default):
    try:
        with open(path) as f: return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError): return default

def _update_json(path, fn):
    """Read-modify-write a JSON file under an exclusive lock."""
    ensure_dirs()
    lock = path + ".lock"
    with open(lock, "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        data = _load(path, {})
        fn(data)
        tmp = path + ".tmp"
        with open(tmp, "w") as f: json.dump(data, f, indent=2)
        os.replace(tmp, path)
        fcntl.flock(lf, fcntl.LOCK_UN)

def slug(s): return re.sub(r"[^a-z0-9_-]+", "-", s.lower()).strip("-") or "agent"

def whoami():
    if os.environ.get("AGENTNET_NAME"): return slug(os.environ["AGENTNET_NAME"])
    cwd = os.getcwd()
    name = _load(DIRNAMES, {}).get(cwd)
    return name or slug(os.path.basename(cwd))

def heartbeat(name, dir_=None):
    def fn(d):
        e = d.get(name, {})
        e["dir"] = dir_ or e.get("dir") or os.getcwd()
        e["last_seen"] = now_iso()
        d[name] = e
    _update_json(AGENTS, fn)

def is_online(entry):
    try:
        seen = datetime.fromisoformat(entry["last_seen"])
        return (datetime.now(timezone.utc) - seen).total_seconds() < ONLINE_WINDOW_S
    except Exception:
        return False

def _actively_watching(entry):
    # Tighter than is_online (which drives the agents-list display). Used ONLY to
    # decide whether a direct send may skip the auto-wake: a heartbeat within a
    # few watch-intervals means the agent is genuinely watching the bus; a
    # stale-but-still-<90s heartbeat (a headless agent that just exited) must NOT
    # be trusted — fall through to the wake so the message actually gets delivered.
    try:
        seen = datetime.fromisoformat(entry["last_seen"])
        return (datetime.now(timezone.utc) - seen).total_seconds() < ACTIVELY_WATCHING_S
    except Exception:
        return False

def myinbox(name):
    p = os.path.join(INBOX, name)
    os.makedirs(os.path.join(p, ".read"), exist_ok=True)
    return p

def deliver(to, msg):
    p = myinbox(to)
    fn = f"{msg['ts_ms']:013d}_{msg['id'][:8]}.json"
    tmp = os.path.join(p, ".read", fn + ".tmp")  # write in .read tmp then move to inbox
    with open(tmp, "w") as f: json.dump(msg, f)
    os.replace(tmp, os.path.join(p, fn))
    with open(LOG, "a") as f: f.write(json.dumps(msg) + "\n")

def pending(name):
    p = myinbox(name)
    files = sorted(fn for fn in os.listdir(p) if fn.endswith(".json"))
    out = []
    for fn in files:
        try:
            with open(os.path.join(p, fn)) as f: out.append((fn, json.load(f)))
        except Exception: pass
    return out

def consume(name, fn):
    p = myinbox(name)
    try: os.replace(os.path.join(p, fn), os.path.join(p, ".read", fn))
    except FileNotFoundError: pass

# ----- commands -----------------------------------------------------------

def cmd_whoami(a): print(whoami())

def cmd_register(a):
    name = slug(a.name) if a.name else whoami()
    if a.name:
        _update_json(DIRNAMES, lambda d: d.__setitem__(os.getcwd(), name))
    heartbeat(name, a.dir or os.getcwd())
    print(f"registered '{name}'  dir={a.dir or os.getcwd()}")

def cmd_agents(a):
    d = _load(AGENTS, {})
    if a.json: print(json.dumps(d, indent=2)); return
    if not d: print("(no agents registered yet)"); return
    for name, e in sorted(d.items()):
        status = "online " if is_online(e) else "offline"
        print(f"  {status}  {name:24}  {e.get('dir','?')}  (seen {e.get('last_seen','?')})")

def cmd_send(a):
    me = whoami(); heartbeat(me)
    broadcast = a.to in ("all", "*", "everyone")
    if broadcast:
        targets = [n for n in _load(AGENTS, {}) if n != me]   # broadcast excludes self
    else:
        targets = [slug(a.to)]                                 # direct send (self allowed, e.g. tests)
    if not targets:
        print(f"no target ('{a.to}' resolved to nothing — no other agents registered to broadcast to)", file=sys.stderr)
        sys.exit(1)
    # Self-addressed message = almost always a MISROUTED reply (you meant to answer
    # whoever messaged you). It silently lands in your OWN inbox and the sender
    # never sees it — this has silently dropped a reply before. Warn loudly; still deliver.
    if not broadcast and targets == [me]:
        hint = f" — did you mean the SENDER of {a.reply_to}?" if a.reply_to else ""
        print(f"⚠️  sending to YOURSELF ('{me}'){hint} this lands in your OWN inbox; "
              f"nobody else sees it. To reply, send to the message's `from` (see `agentnet recv`).",
              file=sys.stderr)
    mid = "msg_" + uuid.uuid4().hex[:12]
    for t in targets:
        deliver(t, {"id": mid, "from": me, "to": t, "ts": now_iso(), "ts_ms": now_ms(),
                    "kind": a.kind, "reply_to": a.reply_to, "body": a.body})
    print(f"sent {mid} -> {', '.join(targets)}")
    # A delivered message only REACHES an agent that's watching the bus (Monitor).
    # An OFFLINE agent — especially a HEADLESS one that exits after each wake —
    # would never see it (it just piles up unread). So auto-wake an offline DIRECT
    # target: the woken agent drains ALL queued messages via `recv`. Online agents
    # are already watching (skip). Debounced so rapid sends don't spawn a wake-storm.
    # Broadcasts and --no-wake skip auto-wake.
    if broadcast or getattr(a, "no_wake", False):
        return
    t = targets[0]
    if t == me:
        return
    entry = _load(AGENTS, {}).get(t) or {}
    if _actively_watching(entry):
        return                                                 # genuinely watching (fresh heartbeat) — sees the msg live. A stale "online" heartbeat (e.g. a headless agent that just exited) falls through to the wake below so the msg is delivered, not lost.
    d = entry.get("dir")
    if not d or not os.path.isdir(d):
        print(f"  ↳ '{t}' is offline with no known dir — message QUEUED but not delivered live. "
              f"`agentnet wake {t} --dir <dir>` (or have it register once) to deliver.", file=sys.stderr)
        return
    _wake(t, d, None, quiet=True)
    print(f"  ↳ '{t}' was offline — woke it (a SINGLE headless worker drains ALL queued messages; concurrent/repeat wakes coalesce into it, never duplicate instances).", file=sys.stderr)

def _print_msg(m, as_json):
    if as_json: print(json.dumps(m)); return
    rt = f" reply_to={m['reply_to']}" if m.get("reply_to") else ""
    print(f"[{m.get('kind','msg')}] {m['id']} from {m['from']}{rt} @ {m['ts']}\n  {m['body']}")

def cmd_recv(a):
    me = whoami(); heartbeat(me)
    msgs = pending(me)
    if not msgs:
        print("(no new messages)" if not a.json else "[]"); return
    if a.json: print(json.dumps([m for _, m in msgs]))
    else:
        for _, m in msgs: _print_msg(m, False)
    if not a.peek:
        for fn, _ in msgs: consume(me, fn)

def cmd_watch(a):
    """Emit one stdout line per inbound message, forever. Run under the Monitor tool."""
    me = whoami()
    print(f"[agentnet] {me} watching for messages... (run under Monitor)", flush=True)
    last_hb = 0.0
    while True:
        if time.time() - last_hb > WATCH_HEARTBEAT_EVERY_S:
            heartbeat(me); last_hb = time.time()
        for fn, m in pending(me):
            body = " ".join(str(m.get("body", "")).splitlines())
            rt = f" reply_to={m['reply_to']}" if m.get("reply_to") else ""
            print(f"[agentnet] MESSAGE from {m['from']} ({m.get('kind','msg')} {m['id']}{rt}): {body}", flush=True)
            consume(me, fn)
        time.sleep(a.interval)

def cmd_ask(a):
    me = whoami(); heartbeat(me)
    target = slug(a.to)
    mid = "msg_" + uuid.uuid4().hex[:12]
    # Queue the question FIRST so a freshly-woken agent finds it on `recv`
    # (waking before delivering races: it could recv an empty inbox and exit).
    deliver(target, {"id": mid, "from": me, "to": target, "ts": now_iso(), "ts_ms": now_ms(),
                     "kind": "ask", "reply_to": None, "body": a.question})
    entry = _load(AGENTS, {}).get(target)
    if a.dir or a.wake or not (entry and is_online(entry)):
        _wake(target, dir_=a.dir, message=None, quiet=True)
    print(f"asked {target}: {a.question}\nwaiting up to {a.timeout}s for a reply (reply_to={mid})...", flush=True)
    deadline = time.time() + a.timeout
    while time.time() < deadline:
        for fn, m in pending(me):
            # the reply = explicit reply_to, or simply the next message back from the target
            if m.get("reply_to") == mid or m.get("from") == target:
                print("\n=== REPLY ==="); _print_msg(m, False); consume(me, fn); return
        time.sleep(1)
    print(f"\n(timeout — no reply from {target} within {a.timeout}s; it may still reply later — `agentnet recv`)")

def _wake_prompt(name, me, message, listen):
    return (
        f"You have been woken as part of the Claude agent network (agent name '{name}'). "
        f"Another agent ('{me}') needs you. FIRST run `agentnet register {name}` then "
        f"`agentnet recv` to read the message(s) addressed to you. Act on them as an ADVISOR: "
        f"answer/investigate within THIS directory, and REPLY by running "
        f"`agentnet send <SENDER> \"<your reply>\" --reply-to <the message id>`, where "
        f"<SENDER> is the `from` field of the message you are answering (shown by "
        f"`agentnet recv`). For the message that woke you, <SENDER> is '{me}'. "
        f"NEVER send to your OWN name ('{name}') — that drops the reply in your own "
        f"inbox and the sender never sees it. "
        f"Do NOT make code changes, commits, deploys, or any irreversible/outward-facing action "
        f"unless the message explicitly asks AND your own CLAUDE.md/safety rules allow it — when unsure, "
        f"reply asking for confirmation instead. The protocol is in ~/.claude/agent-network/README.md. "
        + ("To stay reachable afterward, you may keep watching with the Monitor tool on `agentnet watch`. " if listen else "When done replying, you may stop. ")
        + (f"\n\nThe message: {message}" if message else "")
    )

def _wake(name, dir_, message, quiet=False, listen=False):
    """Ensure (at most) ONE headless worker is running for `name`.

    Previously this spawned `claude -p` directly on every call — so N messages
    to an offline agent over time spawned N racing `claude` instances (a long-
    running woken agent outlives the old time-debounce, and each later send
    re-spawned). Now we spawn a detached SHEPHERD (`__wake-worker`) that takes a
    per-agent flock: the first shepherd wins the lock and runs claude; any
    concurrent/later wake's shepherd finds the lock held and exits at once. The
    winning shepherd DRAIN-LOOPS (re-running claude while messages keep arriving),
    so a single worker delivers everything — never duplicates.
    """
    d = dir_ or _load(AGENTS, {}).get(name, {}).get("dir")
    if not d or not os.path.isdir(d):
        print(f"wake: don't know a directory for '{name}'. Pass --dir, or have it `agentnet register` once.", file=sys.stderr)
        sys.exit(2)
    me = whoami()
    cmd = [sys.executable, os.path.realpath(__file__), "__wake-worker", name, "--dir", d, "--by", me]
    if message: cmd += ["--message", message]
    if listen: cmd += ["--listen"]
    # Detached: the shepherd outlives this CLI call; its claude output -> woke_<name>.log (written inside the shepherd).
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     stdin=subprocess.DEVNULL, start_new_session=True)
    if not quiet:
        print(f"woke '{name}' in {d} (single-worker headless claude, log: {os.path.join(ROOT, f'woke_{name}.log')})")

def cmd_wake_worker(a):
    """Internal shepherd (not a user verb): holds a per-agent flock so only ONE
    runs per agent, then loops `claude -p` until the agent's inbox is drained."""
    name = slug(a.name)
    d = a.dir or _load(AGENTS, {}).get(name, {}).get("dir")
    if not d or not os.path.isdir(d):
        sys.exit(2)
    ensure_dirs()
    lf = open(os.path.join(LOCKS, f"{name}.wake.lock"), "w")
    try:
        fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another worker already owns this agent — it will drain the queue; don't duplicate
    log = os.path.join(ROOT, f"woke_{name}.log")
    prompt = _wake_prompt(name, a.by or "another agent", a.message, a.listen)
    # `claude -p ...`; AGENTNET_WAKE_CMD overrides the launched command for tests.
    test_cmd = os.environ.get("AGENTNET_WAKE_CMD")
    base = test_cmd.split() if test_cmd else ["claude", "-p", prompt, "--permission-mode", "bypassPermissions"]
    if not test_cmd:
        model = os.environ.get("AGENTNET_WAKE_MODEL")  # optional: 'sonnet' for cheaper/faster woken agents
        if model: base += ["--model", model]
    try:
        prev_oldest = None
        for _ in range(MAX_DRAIN_ITERS):
            with open(log, "a") as lfh:
                lfh.write(f"\n\n===== wake {name} @ {now_iso()} (by {a.by}) =====\n")
                subprocess.run(base, cwd=d, stdout=lfh, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
            p = pending(name)
            if not p:
                break                       # inbox fully drained → done
            oldest = p[0][0]
            if oldest == prev_oldest:
                break                       # worker didn't consume the oldest msg → stop (avoid a hot loop)
            prev_oldest = oldest
    finally:
        fcntl.flock(lf, fcntl.LOCK_UN)
        lf.close()

def cmd_wake(a):
    _wake(slug(a.name) if a.name else slug(os.path.basename(a.dir or os.getcwd())),
          a.dir, a.message, listen=a.listen)

def main():
    ensure_dirs()
    p = argparse.ArgumentParser(prog="agentnet", description="Live message bus for Claude Code agents.")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("whoami").set_defaults(func=cmd_whoami)

    sp = sub.add_parser("register"); sp.add_argument("name", nargs="?"); sp.add_argument("--dir"); sp.set_defaults(func=cmd_register)

    sp = sub.add_parser("agents"); sp.add_argument("--json", action="store_true"); sp.set_defaults(func=cmd_agents)

    sp = sub.add_parser("send"); sp.add_argument("to"); sp.add_argument("body")
    sp.add_argument("--reply-to", dest="reply_to"); sp.add_argument("--kind", default="msg")
    sp.add_argument("--no-wake", dest="no_wake", action="store_true", help="just queue; do NOT auto-wake an offline target")
    sp.set_defaults(func=cmd_send)

    sp = sub.add_parser("recv"); sp.add_argument("--json", action="store_true"); sp.add_argument("--peek", action="store_true"); sp.set_defaults(func=cmd_recv)

    sp = sub.add_parser("watch"); sp.add_argument("--interval", type=float, default=1.0); sp.set_defaults(func=cmd_watch)

    sp = sub.add_parser("ask"); sp.add_argument("to"); sp.add_argument("question")
    sp.add_argument("--timeout", type=int, default=180); sp.add_argument("--wake", action="store_true")
    sp.add_argument("--dir", help="directory of the target agent (needed for first contact, before it has registered)")
    sp.set_defaults(func=cmd_ask)

    sp = sub.add_parser("wake"); sp.add_argument("name", nargs="?"); sp.add_argument("--dir")
    sp.add_argument("message", nargs="?"); sp.add_argument("--listen", action="store_true"); sp.set_defaults(func=cmd_wake)

    sp = sub.add_parser("__wake-worker")  # internal: single-worker shepherd spawned by _wake (not a user verb)
    sp.add_argument("name"); sp.add_argument("--dir"); sp.add_argument("--by")
    sp.add_argument("--message"); sp.add_argument("--listen", action="store_true")
    sp.set_defaults(func=cmd_wake_worker)

    a = p.parse_args()
    a.func(a)

if __name__ == "__main__":
    main()
