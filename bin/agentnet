#!/usr/bin/env python3
"""
agentnet — a tiny live message bus for Claude Code agents.

Lets one Claude agent talk DIRECTLY to other Claude agents (1:1 or broadcast),
with no human relaying files. Transport is a shared directory under
~/.claude/agent-network/; the agent-facing verbs are send / recv / watch / ask /
wake. See README.md in that dir.

Identity: an agent's NAME defaults to a slug of its working directory's
basename (so ~/dev/api-server => "api-server"). Override per-dir with
`agentnet register <name>`, or per-process with $AGENTNET_NAME.

Live receive: run `agentnet watch` under the Monitor tool — each inbound message
becomes a live notification while you keep working. Dormant agents: `agentnet
wake <name|--dir DIR>` spawns a headless claude in that dir to join + reply.

Pure stdlib; no deps.
"""
import argparse, json, os, re, sys, time, uuid, subprocess, fcntl, socket, shlex
from datetime import datetime, timezone

ROOT = os.path.join(os.path.expanduser("~"), ".claude", "agent-network")
INBOX = os.path.join(ROOT, "inbox")
LOCKS = os.path.join(ROOT, "locks")           # per-agent wake locks (single-worker guard)
AGENTS = os.path.join(ROOT, "agents.json")
DIRNAMES = os.path.join(ROOT, "dir_names.json")
LOG = os.path.join(ROOT, "log.jsonl")
REMOTES = os.path.join(ROOT, "remotes.json")  # federation config — HUMAN-authored; the CLI ONLY reads it, never writes it
OUTBOX = os.path.join(ROOT, "outbox")         # spool for pools we can't reach (they PULL via __drain-outbox)
ONLINE_WINDOW_S = 90          # "online" = actively watching within this window
WATCH_HEARTBEAT_EVERY_S = 5   # watch refreshes presence this often
ACTIVELY_WATCHING_S = WATCH_HEARTBEAT_EVERY_S * 3  # ~15s. A live `watch` refreshes every 5s, so a heartbeat older than this means NOT actually watching (e.g. a headless agent that finished + exited leaves a stale-but-recent heartbeat). A send must then RE-WAKE rather than assume the msg is seen.
MAX_DRAIN_ITERS = 25          # wake-worker shepherd: max claude runs in one drain-loop (safety cap against a worker that never empties its inbox)
REMOTE_DRAIN_EVERY_S = 5      # `watch` pulls reachable remotes' outboxes (for THIS pool) at most this often
REMOTE_SSH_TIMEOUT_S = 20     # per-hop ssh timeout for remote drain/ack/query (best-effort; a slow/down remote is skipped, never fatal)

def now_iso(): return datetime.now(timezone.utc).isoformat()
def now_ms(): return int(time.time() * 1000)
def ensure_dirs():
    os.makedirs(INBOX, exist_ok=True)
    os.makedirs(LOCKS, exist_ok=True)

def _load(path, default):
    try:
        with open(path) as f: return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError): return default

def _update_json(path, fn):
    """Read-modify-write a JSON file under an exclusive lock."""
    ensure_dirs()
    lock = path + ".lock"
    with open(lock, "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        data = _load(path, {})
        fn(data)
        tmp = path + ".tmp"
        with open(tmp, "w") as f: json.dump(data, f, indent=2)
        os.replace(tmp, path)
        fcntl.flock(lf, fcntl.LOCK_UN)

def slug(s): return re.sub(r"[^a-z0-9_-]+", "-", s.lower()).strip("-") or "agent"

def slug_addr(s):
    """Slug a name, PRESERVING a single `pool:` qualifier: 'VPS:Were Gild' ->
    'vps:were-gild', 'bob' -> 'bob'. The colon is federation's pool/agent separator."""
    if ":" in s:
        pool, agent = s.split(":", 1)
        return f"{slug(pool)}:{slug(agent)}"
    return slug(s)

def parse_addr(s):
    """('server:bob') -> ('server','bob'); ('bob') -> (None,'bob'). First colon splits."""
    if ":" in s:
        pool, agent = s.split(":", 1)
        return slug(pool), slug(agent)
    return None, slug(s)

def qualify(pool, agent):
    return f"{slug(pool)}:{slug(agent)}" if pool else slug(agent)

def load_remotes():
    """Federation config: HUMAN-authored remotes.json (the CLI NEVER writes it) + env
    overrides. Returns {"self": <pool>, "remotes": {name: {ssh, reachable, ssh_opts, bin}}}.
    Absent/empty -> {"self": <hostname slug>, "remotes": {}} -> legacy single-box behaviour.
    A remote is 'reachable' iff it has an ssh target; one without (or reachable:false) is
    'pull-only' — a spool destination we can't push to or wake."""
    cfg = _load(REMOTES, {}) or {}
    self_name = os.environ.get("AGENTNET_SELF") or cfg.get("self") or socket.gethostname()
    remotes = {}
    def add(name, ssh, reachable=None, ssh_opts="", binp="agentnet"):
        ssh = (ssh or "").strip() or None
        remotes[slug(name)] = {
            "ssh": ssh,
            "reachable": bool(ssh) if reachable is None else (bool(ssh) and reachable),
            "ssh_opts": ssh_opts, "bin": binp,
        }
    for name, r in (cfg.get("remotes") or {}).items():
        if isinstance(r, dict):
            add(name, r.get("ssh"), r.get("reachable"), r.get("ssh_opts", ""), r.get("bin", "agentnet"))
    env_r = os.environ.get("AGENTNET_REMOTES", "").strip()
    if env_r:
        for pair in env_r.split(","):
            pair = pair.strip()
            if "=" in pair:
                n, s = pair.split("=", 1); add(n, s)
    return {"self": slug(self_name), "remotes": remotes}

def whoami():
    if os.environ.get("AGENTNET_NAME"): return slug_addr(os.environ["AGENTNET_NAME"])
    cwd = os.getcwd()
    name = _load(DIRNAMES, {}).get(cwd)
    return name or slug(os.path.basename(cwd))

def heartbeat(name, dir_=None):
    def fn(d):
        e = d.get(name, {})
        e["dir"] = dir_ or e.get("dir") or os.getcwd()
        e["last_seen"] = now_iso()
        d[name] = e
    _update_json(AGENTS, fn)

def is_online(entry):
    try:
        seen = datetime.fromisoformat(entry["last_seen"])
        return (datetime.now(timezone.utc) - seen).total_seconds() < ONLINE_WINDOW_S
    except Exception:
        return False

def _actively_watching(entry):
    # Tighter than is_online (which drives the agents-list display). Used ONLY to
    # decide whether a direct send may skip the auto-wake: a heartbeat within a
    # few watch-intervals means the agent is genuinely watching the bus; a
    # stale-but-still-<90s heartbeat (a headless agent that just exited) must NOT
    # be trusted — fall through to the wake so the message actually gets delivered.
    try:
        seen = datetime.fromisoformat(entry["last_seen"])
        return (datetime.now(timezone.utc) - seen).total_seconds() < ACTIVELY_WATCHING_S
    except Exception:
        return False

def myinbox(name):
    p = os.path.join(INBOX, name)
    os.makedirs(os.path.join(p, ".read"), exist_ok=True)
    return p

def deliver(to, msg):
    p = myinbox(to)
    fn = f"{msg['ts_ms']:013d}_{msg['id'][:8]}.json"
    tmp = os.path.join(p, ".read", fn + ".tmp")  # write in .read tmp then move to inbox
    with open(tmp, "w") as f: json.dump(msg, f)
    os.replace(tmp, os.path.join(p, fn))
    with open(LOG, "a") as f: f.write(json.dumps(msg) + "\n")

def spool(dest_pool, msg):
    """Queue a cross-pool message we can't push into outbox/<dest_pool>/ for that pool to
    PULL (two-phase drain). Same atomic tmp->rename + {ts_ms}_{id} naming as deliver()."""
    p = os.path.join(OUTBOX, dest_pool)
    os.makedirs(os.path.join(p, ".drained"), exist_ok=True)
    fn = f"{msg['ts_ms']:013d}_{msg['id'][:8]}.json"
    tmp = os.path.join(p, ".drained", fn + ".tmp")
    with open(tmp, "w") as f: json.dump(msg, f)
    os.replace(tmp, os.path.join(p, fn))
    with open(LOG, "a") as f: f.write(json.dumps(msg) + "\n")

def _qual_self(cfg, me):
    """The sender's pool-qualified name for a cross-pool message (so replies route home).
    An already-qualified name (a remote push set AGENTNET_NAME=pool:agent) passes through."""
    return me if ":" in me else f"{cfg['self']}:{me}"

def _send_remote(cfg, pool, agent, me, a):
    """Route a cross-pool send: PUSH over ssh to a reachable pool (its own CLI stamps
    from + auto-wakes locally), or SPOOL to outbox/ for a pull-only pool to drain."""
    r = cfg["remotes"].get(pool)
    if not r:
        print(f"send: unknown remote pool '{pool}' — `agentnet remotes` lists configured "
              f"pools (remotes.json / AGENTNET_REMOTES).", file=sys.stderr); sys.exit(1)
    frm = _qual_self(cfg, me)
    if r["reachable"]:
        argv = [r["bin"], "send", agent, a.body]
        if a.reply_to: argv += ["--reply-to", a.reply_to]
        if a.kind and a.kind != "msg": argv += ["--kind", a.kind]
        if getattr(a, "no_wake", False): argv += ["--no-wake"]
        # env-prefix (PATH so a non-interactive shell finds agentnet; AGENTNET_NAME so the
        # far side stamps `from`) stays UNQUOTED for $HOME/$PATH expansion; args are quoted.
        remote_cmd = ("PATH=$HOME/.local/bin:$PATH AGENTNET_NAME=" + shlex.quote(frm) + " "
                      + " ".join(shlex.quote(x) for x in argv))
        ssh_argv = ["ssh"] + shlex.split(r["ssh_opts"] or "") + [r["ssh"], remote_cmd]
        res = subprocess.run(ssh_argv, text=True, capture_output=True)
        if res.stdout: sys.stdout.write(res.stdout)
        if res.stderr: sys.stderr.write(res.stderr)
        if res.returncode != 0:
            print(f"send: ssh push to '{pool}' ({r['ssh']}) failed (exit {res.returncode}).", file=sys.stderr)
            sys.exit(1)
        print(f"  ↳ pushed to {pool}:{agent} via ssh {r['ssh']}")
    else:
        mid = "msg_" + uuid.uuid4().hex[:12]
        spool(pool, {"id": mid, "from": frm, "to": f"{pool}:{agent}", "ts": now_iso(),
                     "ts_ms": now_ms(), "kind": a.kind, "reply_to": a.reply_to, "body": a.body})
        print(f"sent {mid} -> {pool}:{agent} (spooled; '{pool}' is pull-only — drains on its next recv)")

def pending(name):
    p = myinbox(name)
    files = sorted(fn for fn in os.listdir(p) if fn.endswith(".json"))
    out = []
    for fn in files:
        try:
            with open(os.path.join(p, fn)) as f: out.append((fn, json.load(f)))
        except Exception: pass
    return out

def consume(name, fn):
    p = myinbox(name)
    try: os.replace(os.path.join(p, fn), os.path.join(p, ".read", fn))
    except FileNotFoundError: pass

# ----- commands -----------------------------------------------------------

def cmd_whoami(a): print(whoami())

def cmd_register(a):
    name = slug(a.name) if a.name else whoami()
    if a.name:
        _update_json(DIRNAMES, lambda d: d.__setitem__(os.getcwd(), name))
    heartbeat(name, a.dir or os.getcwd())
    print(f"registered '{name}'  dir={a.dir or os.getcwd()}")

def cmd_agents(a):
    local = _load(AGENTS, {})
    allf = getattr(a, "all", False)
    if a.json and not allf:
        print(json.dumps(local, indent=2)); return
    if not allf:
        if not local: print("(no agents registered yet)"); return
        for name, e in sorted(local.items()):
            status = "online " if is_online(e) else "offline"
            print(f"  {status}  {name:24}  {e.get('dir','?')}  (seen {e.get('last_seen','?')})")
        return
    # --all: federation-wide view — local agents prefixed `self:`, each reachable remote's
    # agents queried over ssh and prefixed `<remote>:`. Pull-only pools aren't queryable.
    cfg = load_remotes()
    def show(prefix, d):
        for name, e in sorted(d.items()):
            status = "online " if is_online(e) else "offline"
            print(f"  {status}  {prefix}:{name}")
    show(cfg["self"], local)
    for rname, r in sorted(cfg["remotes"].items()):
        if not r["reachable"]:
            print(f"  (pull-only  {rname}: not queryable)"); continue
        try:
            res = _ssh_run(r, _remote_agentnet(r, "agents", "--json"))
            rd = json.loads(res.stdout) if res.returncode == 0 and res.stdout.strip() else {}
        except Exception:
            rd = {}
        show(rname, rd)

def cmd_remotes(a):
    cfg = load_remotes()
    print(f"self: {cfg['self']}")
    rem = cfg["remotes"]
    if not rem:
        print("  (no remotes configured — single-box mode)"); return
    for name, r in sorted(rem.items()):
        if r["reachable"]:
            print(f"  reachable  {name:16}  ssh={r['ssh']}")
        else:
            print(f"  pull-only  {name:16}  (spool only; not reachable/wakeable)")

def _load_remotes_raw():
    """The raw remotes.json for EDITING (preserves `self` + any hand-added fields). {} if absent."""
    return _load(REMOTES, {}) or {}

def _write_remotes_raw(d):
    d.setdefault("_comment", "Managed by `agentnet remote add/rm/self` (also hand-editable). "
                             "Keep out of version control — it names your hosts.")
    ensure_dirs()
    tmp = REMOTES + ".tmp"
    with open(tmp, "w") as f: json.dump(d, f, indent=2)
    os.replace(tmp, REMOTES)

def _ensure_self(d):
    if not d.get("self"):
        d["self"] = slug(os.environ.get("AGENTNET_SELF") or socket.gethostname())
    d.setdefault("remotes", {})
    return d

def cmd_remote_add(a):
    """Add/update a remote in remotes.json. With an ssh target it's REACHABLE (you push);
    without one it's PULL-ONLY (it pulls from you — e.g. it's behind NAT)."""
    d = _ensure_self(_load_remotes_raw())
    name = slug(a.name)
    entry = d["remotes"].get(name, {})
    if a.ssh:
        entry["ssh"] = a.ssh; entry.pop("reachable", None)
        d["remotes"][name] = entry; _write_remotes_raw(d)
        print(f"added remote '{name}' — reachable (you push over ssh {a.ssh}). self={d['self']}")
    else:
        entry.pop("ssh", None); entry["reachable"] = False
        d["remotes"][name] = entry; _write_remotes_raw(d)
        print(f"added remote '{name}' — pull-only (it pulls from you; you can't push or wake it). self={d['self']}")

def cmd_remote_rm(a):
    d = _load_remotes_raw()
    name = slug(a.name)
    if name in d.get("remotes", {}):
        del d["remotes"][name]; _write_remotes_raw(d)
        print(f"removed remote '{name}'")
    else:
        print(f"no such remote '{name}' — `agentnet remotes` lists them", file=sys.stderr); sys.exit(1)

def cmd_remote_self(a):
    """Get (no arg) or set your own pool name — used to qualify your `from` across pools."""
    if a.name:
        d = _ensure_self(_load_remotes_raw()); d["self"] = slug(a.name); _write_remotes_raw(d)
        print(f"self = {d['self']}")
    else:
        print(load_remotes()["self"])

def cmd_send(a):
    me = whoami(); heartbeat(me)
    cfg = load_remotes()
    broadcast = a.to in ("all", "*", "everyone")
    if not broadcast:
        pool, agent = parse_addr(a.to)
        if pool and pool != cfg["self"]:
            return _send_remote(cfg, pool, agent, me, a)       # cross-pool: push or spool
        targets = [agent]                                      # local (a `self:` prefix is stripped)
    else:
        targets = [n for n in _load(AGENTS, {}) if n != me]    # local broadcast (Phase 1: within-pool)
    if not targets:
        print(f"no target ('{a.to}' resolved to nothing — no other agents registered to broadcast to)", file=sys.stderr)
        sys.exit(1)
    # Self-addressed message = almost always a MISROUTED reply (you meant to answer
    # whoever messaged you). It silently lands in your OWN inbox and the sender
    # never sees it — this has silently dropped a reply before. Warn loudly; still deliver.
    if not broadcast and targets == [me]:
        hint = f" — did you mean the SENDER of {a.reply_to}?" if a.reply_to else ""
        print(f"⚠️  sending to YOURSELF ('{me}'){hint} this lands in your OWN inbox; "
              f"nobody else sees it. To reply, send to the message's `from` (see `agentnet recv`).",
              file=sys.stderr)
    mid = "msg_" + uuid.uuid4().hex[:12]
    for t in targets:
        deliver(t, {"id": mid, "from": me, "to": t, "ts": now_iso(), "ts_ms": now_ms(),
                    "kind": a.kind, "reply_to": a.reply_to, "body": a.body})
    print(f"sent {mid} -> {', '.join(targets)}")
    # A delivered message only REACHES an agent that's watching the bus (Monitor).
    # An OFFLINE agent — especially a HEADLESS one that exits after each wake —
    # would never see it (it just piles up unread). So auto-wake an offline DIRECT
    # target: the woken agent drains ALL queued messages via `recv`. Online agents
    # are already watching (skip). Debounced so rapid sends don't spawn a wake-storm.
    # Broadcasts and --no-wake skip auto-wake.
    if broadcast or getattr(a, "no_wake", False):
        return
    t = targets[0]
    if t == me:
        return
    entry = _load(AGENTS, {}).get(t) or {}
    if _actively_watching(entry):
        return                                                 # genuinely watching (fresh heartbeat) — sees the msg live. A stale "online" heartbeat (e.g. a headless agent that just exited) falls through to the wake below so the msg is delivered, not lost.
    d = entry.get("dir")
    if not d or not os.path.isdir(d):
        print(f"  ↳ '{t}' is offline with no known dir — message QUEUED but not delivered live. "
              f"`agentnet wake {t} --dir <dir>` (or have it register once) to deliver.", file=sys.stderr)
        return
    _wake(t, d, None, quiet=True)
    print(f"  ↳ '{t}' was offline — woke it (a SINGLE headless worker drains ALL queued messages; concurrent/repeat wakes coalesce into it, never duplicate instances).", file=sys.stderr)

def _print_msg(m, as_json):
    if as_json: print(json.dumps(m)); return
    rt = f" reply_to={m['reply_to']}" if m.get("reply_to") else ""
    print(f"[{m.get('kind','msg')}] {m['id']} from {m['from']}{rt} @ {m['ts']}\n  {m['body']}")

def _has_id(name, mid):
    """True if a message id is already in <name>'s inbox or .read (dedupe)."""
    if not mid: return False
    p = myinbox(name)
    for d in (p, os.path.join(p, ".read")):
        try:
            for fn in os.listdir(d):
                if fn.endswith(".json") and mid[:8] in fn:
                    try:
                        with open(os.path.join(d, fn)) as f:
                            if json.load(f).get("id") == mid: return True
                    except Exception: pass
        except FileNotFoundError: pass
    return False

def _deposit_local(msg):
    """Deposit a pulled cross-pool message into its TARGET agent's local inbox, idempotent
    by id (so a re-drain before ack can't double-deliver). Returns True if newly stored."""
    _, agent = parse_addr(msg.get("to", "") or "agent")
    if _has_id(agent, msg.get("id")): return False
    deliver(agent, msg)
    return True

def _ssh_run(r, remote_cmd):
    argv = ["ssh"] + shlex.split(r["ssh_opts"] or "") + [r["ssh"], remote_cmd]
    return subprocess.run(argv, text=True, capture_output=True, timeout=REMOTE_SSH_TIMEOUT_S)

def _remote_agentnet(r, *verb_args):
    return (f"PATH=$HOME/.local/bin:$PATH {shlex.quote(r['bin'])} "
            + " ".join(shlex.quote(x) for x in verb_args))

def drain_remotes(cfg):
    """Pull messages spooled for THIS pool on each reachable remote, deposit each into its
    target agent's local inbox (dedupe), then ack exactly what we saw (two-phase: no loss,
    no dupes). Best-effort: a down/erroring remote is skipped with a warning, never fatal.
    Whoever calls this drains the WHOLE pool outbox and fans messages out to local inboxes;
    each agent then reads only its own."""
    self_pool = cfg["self"]; got = 0
    for name, r in cfg["remotes"].items():
        if not r["reachable"]: continue
        try:
            res = _ssh_run(r, _remote_agentnet(r, "__drain-outbox", self_pool))
        except Exception as e:
            print(f"  ↳ drain '{name}' skipped: {e}", file=sys.stderr); continue
        if res.returncode != 0:
            print(f"  ↳ drain '{name}' skipped (ssh exit {res.returncode})", file=sys.stderr); continue
        seen = []
        for line in res.stdout.splitlines():
            line = line.strip()
            if not line: continue
            try: msg = json.loads(line)
            except Exception: continue
            if _deposit_local(msg): got += 1
            if msg.get("id"): seen.append(msg["id"])
        if seen:
            try: _ssh_run(r, _remote_agentnet(r, "__ack-drain", self_pool, *seen))
            except Exception: pass
    return got

def cmd_recv(a):
    me = whoami(); heartbeat(me)
    cfg = load_remotes()
    if cfg["remotes"]: drain_remotes(cfg)   # pull cross-pool messages spooled for us
    msgs = pending(me)
    if not msgs:
        print("(no new messages)" if not a.json else "[]"); return
    if a.json: print(json.dumps([m for _, m in msgs]))
    else:
        for _, m in msgs: _print_msg(m, False)
    if not a.peek:
        for fn, _ in msgs: consume(me, fn)

def cmd_watch(a):
    """Emit one stdout line per inbound message, forever. Run under the Monitor tool."""
    me = whoami()
    cfg = load_remotes()
    print(f"[agentnet] {me} watching for messages... (run under Monitor)", flush=True)
    last_hb = 0.0; last_drain = 0.0
    while True:
        now = time.time()
        if now - last_hb > WATCH_HEARTBEAT_EVERY_S:
            heartbeat(me); last_hb = now
        if cfg["remotes"] and now - last_drain > REMOTE_DRAIN_EVERY_S:
            try: drain_remotes(cfg)   # pull cross-pool messages spooled for us
            except Exception: pass
            last_drain = now
        for fn, m in pending(me):
            body = " ".join(str(m.get("body", "")).splitlines())
            rt = f" reply_to={m['reply_to']}" if m.get("reply_to") else ""
            print(f"[agentnet] MESSAGE from {m['from']} ({m.get('kind','msg')} {m['id']}{rt}): {body}", flush=True)
            consume(me, fn)
        time.sleep(a.interval)

def cmd_ask(a):
    me = whoami(); heartbeat(me)
    target = slug(a.to)
    mid = "msg_" + uuid.uuid4().hex[:12]
    # Queue the question FIRST so a freshly-woken agent finds it on `recv`
    # (waking before delivering races: it could recv an empty inbox and exit).
    deliver(target, {"id": mid, "from": me, "to": target, "ts": now_iso(), "ts_ms": now_ms(),
                     "kind": "ask", "reply_to": None, "body": a.question})
    entry = _load(AGENTS, {}).get(target)
    if a.dir or a.wake or not (entry and is_online(entry)):
        _wake(target, dir_=a.dir, message=None, quiet=True)
    print(f"asked {target}: {a.question}\nwaiting up to {a.timeout}s for a reply (reply_to={mid})...", flush=True)
    deadline = time.time() + a.timeout
    while time.time() < deadline:
        for fn, m in pending(me):
            # the reply = explicit reply_to, or simply the next message back from the target
            if m.get("reply_to") == mid or m.get("from") == target:
                print("\n=== REPLY ==="); _print_msg(m, False); consume(me, fn); return
        time.sleep(1)
    print(f"\n(timeout — no reply from {target} within {a.timeout}s; it may still reply later — `agentnet recv`)")

def _wake_prompt(name, me, message, listen):
    return (
        f"You have been woken as part of the Claude agent network (agent name '{name}'). "
        f"Another agent ('{me}') needs you. FIRST run `agentnet register {name}` then "
        f"`agentnet recv` to read the message(s) addressed to you. Act on them as an ADVISOR: "
        f"answer/investigate within THIS directory, and REPLY by running "
        f"`agentnet send <SENDER> \"<your reply>\" --reply-to <the message id>`, where "
        f"<SENDER> is the `from` field of the message you are answering (shown by "
        f"`agentnet recv`). For the message that woke you, <SENDER> is '{me}'. "
        f"NEVER send to your OWN name ('{name}') — that drops the reply in your own "
        f"inbox and the sender never sees it. "
        f"Do NOT make code changes, commits, deploys, or any irreversible/outward-facing action "
        f"unless the message explicitly asks AND your own CLAUDE.md/safety rules allow it — when unsure, "
        f"reply asking for confirmation instead. The protocol is in ~/.claude/agent-network/README.md. "
        + ("To stay reachable afterward, you may keep watching with the Monitor tool on `agentnet watch`. " if listen else "When done replying, you may stop. ")
        + (f"\n\nThe message: {message}" if message else "")
    )

def _wake(name, dir_, message, quiet=False, listen=False):
    """Ensure (at most) ONE headless worker is running for `name`.

    Previously this spawned `claude -p` directly on every call — so N messages
    to an offline agent over time spawned N racing `claude` instances (a long-
    running woken agent outlives the old time-debounce, and each later send
    re-spawned). Now we spawn a detached SHEPHERD (`__wake-worker`) that takes a
    per-agent flock: the first shepherd wins the lock and runs claude; any
    concurrent/later wake's shepherd finds the lock held and exits at once. The
    winning shepherd DRAIN-LOOPS (re-running claude while messages keep arriving),
    so a single worker delivers everything — never duplicates.
    """
    d = dir_ or _load(AGENTS, {}).get(name, {}).get("dir")
    if not d or not os.path.isdir(d):
        print(f"wake: don't know a directory for '{name}'. Pass --dir, or have it `agentnet register` once.", file=sys.stderr)
        sys.exit(2)
    me = whoami()
    cmd = [sys.executable, os.path.realpath(__file__), "__wake-worker", name, "--dir", d, "--by", me]
    if message: cmd += ["--message", message]
    if listen: cmd += ["--listen"]
    # Detached: the shepherd outlives this CLI call; its claude output -> woke_<name>.log (written inside the shepherd).
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     stdin=subprocess.DEVNULL, start_new_session=True)
    if not quiet:
        print(f"woke '{name}' in {d} (single-worker headless claude, log: {os.path.join(ROOT, f'woke_{name}.log')})")

def _outbox_dir(pool):
    p = os.path.join(OUTBOX, pool)
    os.makedirs(os.path.join(p, ".drained"), exist_ok=True)
    return p

def cmd_drain_outbox(a):
    """Phase 1 of the two-phase pull (internal transport verb): PRINT — one JSON per line —
    the messages spooled for <pool>, WITHOUT removing them. Snapshot under an exclusive lock
    so a message written mid-drain waits for the next drain (never half-read). The caller
    deposits locally + fsync, then calls `__ack-drain` to archive exactly what it stored —
    at-least-once + inbox dedupe = no loss, no dupes."""
    pool = slug(a.pool)
    p = _outbox_dir(pool)
    with open(os.path.join(OUTBOX, pool + ".lock"), "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        files = sorted(fn for fn in os.listdir(p) if fn.endswith(".json"))
        out = []
        for fn in files:
            try:
                with open(os.path.join(p, fn)) as f: out.append(json.load(f))
            except Exception: pass
        fcntl.flock(lf, fcntl.LOCK_UN)
    for m in out:
        print(json.dumps(m))

def cmd_ack_drain(a):
    """Phase 2 (internal): archive (move to .drained/) exactly the message ids the caller
    confirms it stored. Ids not present are ignored (already archived / never existed)."""
    pool = slug(a.pool)
    p = _outbox_dir(pool)
    want = set(a.ids)
    moved = 0
    with open(os.path.join(OUTBOX, pool + ".lock"), "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        for fn in list(os.listdir(p)):
            if not fn.endswith(".json"): continue
            try:
                with open(os.path.join(p, fn)) as f: mid = json.load(f).get("id")
            except Exception: continue
            if mid in want:
                try: os.replace(os.path.join(p, fn), os.path.join(p, ".drained", fn)); moved += 1
                except FileNotFoundError: pass
        fcntl.flock(lf, fcntl.LOCK_UN)
    print(f"acked {moved}")

def cmd_wake_worker(a):
    """Internal shepherd (not a user verb): holds a per-agent flock so only ONE
    runs per agent, then loops `claude -p` until the agent's inbox is drained."""
    name = slug(a.name)
    d = a.dir or _load(AGENTS, {}).get(name, {}).get("dir")
    if not d or not os.path.isdir(d):
        sys.exit(2)
    ensure_dirs()
    lf = open(os.path.join(LOCKS, f"{name}.wake.lock"), "w")
    try:
        fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another worker already owns this agent — it will drain the queue; don't duplicate
    log = os.path.join(ROOT, f"woke_{name}.log")
    prompt = _wake_prompt(name, a.by or "another agent", a.message, a.listen)
    # `claude -p ...`; AGENTNET_WAKE_CMD overrides the launched command for tests.
    test_cmd = os.environ.get("AGENTNET_WAKE_CMD")
    base = test_cmd.split() if test_cmd else ["claude", "-p", prompt, "--permission-mode", "bypassPermissions"]
    if not test_cmd:
        model = os.environ.get("AGENTNET_WAKE_MODEL")  # optional: 'sonnet' for cheaper/faster woken agents
        if model: base += ["--model", model]
    try:
        prev_oldest = None
        for _ in range(MAX_DRAIN_ITERS):
            with open(log, "a") as lfh:
                lfh.write(f"\n\n===== wake {name} @ {now_iso()} (by {a.by}) =====\n")
                subprocess.run(base, cwd=d, stdout=lfh, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
            p = pending(name)
            if not p:
                break                       # inbox fully drained → done
            oldest = p[0][0]
            if oldest == prev_oldest:
                break                       # worker didn't consume the oldest msg → stop (avoid a hot loop)
            prev_oldest = oldest
    finally:
        fcntl.flock(lf, fcntl.LOCK_UN)
        lf.close()

def cmd_wake(a):
    _wake(slug(a.name) if a.name else slug(os.path.basename(a.dir or os.getcwd())),
          a.dir, a.message, listen=a.listen)

def main():
    ensure_dirs()
    p = argparse.ArgumentParser(prog="agentnet", description="Live message bus for Claude Code agents.")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("whoami").set_defaults(func=cmd_whoami)

    sp = sub.add_parser("register"); sp.add_argument("name", nargs="?"); sp.add_argument("--dir"); sp.set_defaults(func=cmd_register)

    sp = sub.add_parser("agents"); sp.add_argument("--json", action="store_true"); sp.add_argument("--all", action="store_true"); sp.set_defaults(func=cmd_agents)

    sub.add_parser("remotes").set_defaults(func=cmd_remotes)   # alias for `remote list`

    rp = sub.add_parser("remote"); rp.set_defaults(func=cmd_remotes)   # bare `remote` -> list
    rsub = rp.add_subparsers(dest="rcmd")
    rsub.add_parser("list").set_defaults(func=cmd_remotes)
    _ra = rsub.add_parser("add"); _ra.add_argument("name"); _ra.add_argument("ssh", nargs="?"); _ra.set_defaults(func=cmd_remote_add)
    _rx = rsub.add_parser("rm"); _rx.add_argument("name"); _rx.set_defaults(func=cmd_remote_rm)
    _rs = rsub.add_parser("self"); _rs.add_argument("name", nargs="?"); _rs.set_defaults(func=cmd_remote_self)

    sp = sub.add_parser("send"); sp.add_argument("to"); sp.add_argument("body")
    sp.add_argument("--reply-to", dest="reply_to"); sp.add_argument("--kind", default="msg")
    sp.add_argument("--no-wake", dest="no_wake", action="store_true", help="just queue; do NOT auto-wake an offline target")
    sp.set_defaults(func=cmd_send)

    sp = sub.add_parser("recv"); sp.add_argument("--json", action="store_true"); sp.add_argument("--peek", action="store_true"); sp.set_defaults(func=cmd_recv)

    sp = sub.add_parser("watch"); sp.add_argument("--interval", type=float, default=1.0); sp.set_defaults(func=cmd_watch)

    sp = sub.add_parser("ask"); sp.add_argument("to"); sp.add_argument("question")
    sp.add_argument("--timeout", type=int, default=180); sp.add_argument("--wake", action="store_true")
    sp.add_argument("--dir", help="directory of the target agent (needed for first contact, before it has registered)")
    sp.set_defaults(func=cmd_ask)

    sp = sub.add_parser("wake"); sp.add_argument("name", nargs="?"); sp.add_argument("--dir")
    sp.add_argument("message", nargs="?"); sp.add_argument("--listen", action="store_true"); sp.set_defaults(func=cmd_wake)

    sp = sub.add_parser("__wake-worker")  # internal: single-worker shepherd spawned by _wake (not a user verb)
    sp.add_argument("name"); sp.add_argument("--dir"); sp.add_argument("--by")
    sp.add_argument("--message"); sp.add_argument("--listen", action="store_true")
    sp.set_defaults(func=cmd_wake_worker)

    # internal transport verbs (prefix `__` = not user-facing): the two-phase outbox pull.
    sp = sub.add_parser("__drain-outbox"); sp.add_argument("pool"); sp.set_defaults(func=cmd_drain_outbox)
    sp = sub.add_parser("__ack-drain"); sp.add_argument("pool"); sp.add_argument("ids", nargs="*"); sp.set_defaults(func=cmd_ack_drain)

    a = p.parse_args()
    a.func(a)

if __name__ == "__main__":
    main()
